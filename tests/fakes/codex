#!/usr/bin/env python3
"""Fake OpenAI Codex CLI for the tests. Mimics the `codex exec` flags of codex-cli 0.171.0 that the adapter uses:
the prompt from stdin ("-"), --json events on stdout, -o for the last message, --sandbox for what it may write."""

import json
import os
import sys

import _fake

argv = sys.argv[1:]
if argv[:1] in (["--version"], ["-V"]):
    print("codex-cli 0.0.0-fake")
    sys.exit(0)
if argv[:1] != ["exec"]:
    _fake.finish(2, "", "error: this fake only supports exec\n")


def value(flag):
    for i, a in enumerate(argv):
        if a == flag and i + 1 < len(argv):
            return argv[i + 1]
    return None


prompt = sys.stdin.read() if argv[-1] == "-" else argv[-1]
sc = _fake.scenario(prompt, "codex")
cwd = value("--cd") or os.getcwd()
_fake.log("codex", argv, cwd, sc)

may_write = value("--sandbox") in ("workspace-write", "danger-full-access")
code, out, err = _fake.act("codex", sc, cwd, may_write, prompt)
if sc == "probe":
    out += "\nPROBE " + json.dumps(_fake.probe(prompt))
events = [{"type": "thread.started", "thread_id": "fake-thread-1"}, {"type": "turn.started"}]
if code == 0:
    events += [{"type": "item.completed", "item": {"id": "item_0", "type": "agent_message", "text": "working on it"}},
               {"type": "item.completed", "item": {"id": "item_1", "type": "agent_message", "text": out}},
               {"type": "turn.completed", "usage": {"input_tokens": 1000, "cached_input_tokens": 800,
                                                    "output_tokens": 200, "reasoning_output_tokens": 50}}]
    last = value("-o")
    if last:
        with open(last, "w", encoding="utf-8") as f:
            f.write(out)
else:
    events += [{"type": "error", "message": err.strip()}, {"type": "turn.failed", "error": {"message": err.strip()}}]
_fake.finish(code, "".join(json.dumps(e) + "\n" for e in events), "Reading additional input from stdin...\n")
