#!/usr/bin/env python3
"""Fake bubblewrap for the tests: logs its arguments, then runs the command after "--" WITHOUT any sandbox,
honoring --chdir. FAKE_BWRAP_FAIL=1 makes it fail like a system where user namespaces are disabled."""

import os
import sys

import _log

argv = sys.argv[1:]
if os.environ.get("FAKE_BWRAP_FAIL"):
    sys.stderr.write("bwrap: setting up uid map: Permission denied\n")
    sys.exit(1)
if "--" not in argv:
    sys.stderr.write("fake bwrap: expected -- before the command\n")
    sys.exit(2)
opts, cmd = argv[:argv.index("--")], argv[argv.index("--") + 1:]
if cmd != ["true"]:  # the availability check is not logged
    _log.log("bwrap", opts, command=cmd)
if "--chdir" in opts:
    os.chdir(opts[opts.index("--chdir") + 1])
os.execvp(cmd[0], cmd)
